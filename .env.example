# Copy to .env and fill in. .env is gitignored and must stay that way.
# Invariant 5: credentials come from the environment. Never inline a key in a
# notebook or module, and never print one into an output cell — a committed
# service key exposes the whole dataset.

# --- Supabase -----------------------------------------------------------------
# The study database. Read access to participant rows is restricted; see the
# retention and access section of docs/event-model.md.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# --- The agent under test -----------------------------------------------------
# A DATED RELEASE, never an alias. Invariant 2: an alias that moves without
# notice makes an observed difference impossible to attribute. This value is
# recorded in every run's metadata.
VERTEX_API_KEY=
VERTEX_MODEL=

# --- The simulator and the judge ----------------------------------------------
# Also dated releases, and deliberately named separately from the agent: the
# three roles are allowed to differ, but which model played which role must be
# recoverable from a run's metadata.
# D20: both gemini-3.5-flash, through the same Vertex key as the agent.
SIMULATOR_MODEL=gemini-3.5-flash
JUDGE_MODEL=gemini-3.5-flash

# --- The manuscript -----------------------------------------------------------
# Optional. tools/manuscript.py falls back to the newest MA_Thesis_*.docx in the
# default OneDrive folder. Set MA_MANUSCRIPT to pin one exact revision when a
# result must be reproducible against it.
# MA_MANUSCRIPT=
# MA_MANUSCRIPT_DIR=

# --- The harness (Phase B) ------------------------------------------------------
# The API the simulator drives — the deployed one for runs of record (D15), the
# dev server while developing. The simulated accounts share one password, which
# never leaves this file; their emails are deterministic under an undeliverable
# domain (src/auth.py).
API_BASE_URL=http://localhost:3001/api
SIM_USER_PASSWORD=
# SIM_USER_COUNT=2
# SIM_USER_DOMAIN=sim.triptonic.invalid
